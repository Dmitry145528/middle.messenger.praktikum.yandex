<main class="login-card">
  <h1 class="login-card__title">Вход</h1>

  <form class="login-form">
    <div class="login-form__inputs">
      {{{ Input label="Логин" name="login" type="text" placeholder="Логин или email" ref="login" error=errors.login value=values.login }}}
      {{{ Input label="Пароль" name="password" type="password" placeholder="Введите пароль" ref="password" error=errors.password value=values.password }}}
    </div>

    <div class="login-form__actions">
      {{{ Button text="Войти" type="primary" htmlType="submit" }}}
      {{{ Link text="Ещё не зарегистрированы?" href="/register" className="login-form__link" }}}
    </div>
  </form>
</main>
