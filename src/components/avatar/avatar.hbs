<label class="avatar__container {{#if canEdit}}avatar__container--editable{{/if}}">
	{{#if src}}
	<img src="{{src}}" alt="avatar" class="avatar__image">
	{{else}}
	<img class="avatar__placeholder" src="/picture.svg" alt="avatar placeholder">
	{{/if}}

	{{#if canEdit}}
	<button class="avatar__overlay">Поменять аватар</button>
	<input type="file" name="avatar" class="avatar__input" accept="image/*">
	{{/if}}
</label>
